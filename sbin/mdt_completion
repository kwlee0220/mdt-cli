#!/usr/bin/env bash
#
# mdt_completion - MDT Command Completion
# ======================================
#
# Bash completion for `mdt` and `mdt_picocli`.
# Picocli completion + MDT API dynamic completion (instance IDs, parameters,
# operations, arguments, submodels, timeseries, elements, wfmodels, workflows).
# Requires: MDT_URL, MDT_WORKFLOW_ENDPOINT (optional, for dynamic lists).
#
# The picocli part is generated by picocli 4.7.6
# (java -cp mdt-cli-all.jar picocli.AutoComplete -n mdt_picocli mdt.cli.MDTCommandsMain)
# and the MDT API dynamic completion helpers/hooks are merged into it.
#
# Installation
# ------------
#
# 1. Source all completion scripts in your .bash_profile
#
#   cd $YOUR_APP_HOME/bin
#   for f in $(find . -name "*_completion"); do line=". $(pwd)/$f"; grep "$line" ~/.bash_profile || echo "$line" >> ~/.bash_profile; done
#
# 2. Open a new bash console, and type `mdt_picocli [TAB][TAB]`
#
# 1a. Alternatively, if you have [bash-completion](https://github.com/scop/bash-completion) installed:
#     Place this file in a `bash-completion.d` folder:
#
#   * /etc/bash-completion.d
#   * /usr/local/etc/bash-completion.d
#   * ~/bash-completion.d
#
# Documentation
# -------------
# The script is called by bash whenever [TAB] or [TAB][TAB] is pressed after
# 'mdt_picocli (..)'. By reading entered command line parameters,
# it determines possible bash completions and writes them to the COMPREPLY variable.
# Bash then completes the user input if only one entry is listed in the variable or
# shows the options if more than one is listed in COMPREPLY.
#
# References
# ----------
# [1] http://stackoverflow.com/a/12495480/1440785
# [2] http://tiswww.case.edu/php/chet/bash/FAQ
# [3] https://www.gnu.org/software/bash/manual/html_node/The-Shopt-Builtin.html
# [4] http://zsh.sourceforge.net/Doc/Release/Options.html#index-COMPLETE_005fALIASES
# [5] https://stackoverflow.com/questions/17042057/bash-check-element-in-array-for-elements-in-another-array/17042655#17042655
# [6] https://www.gnu.org/software/bash/manual/html_node/Programmable-Completion.html#Programmable-Completion
# [7] https://stackoverflow.com/questions/3249432/can-a-bash-tab-completion-script-be-used-in-zsh/27853970#27853970
#

if [ -n "$BASH_VERSION" ]; then
  # Enable programmable completion facilities when using bash (see [3])
  shopt -s progcomp
elif [ -n "$ZSH_VERSION" ]; then
  # Make alias a distinct command for completion purposes when using zsh (see [4])
  setopt COMPLETE_ALIASES
  alias compopt=complete

  # Enable bash completion in zsh (see [7])
  # Only initialize completions module once to avoid unregistering existing completions.
  if ! type compdef > /dev/null; then
    autoload -U +X compinit && compinit
  fi
  autoload -U +X bashcompinit && bashcompinit
fi

# CompWordsContainsArray takes an array and then checks
# if all elements of this array are in the global COMP_WORDS array.
#
# Returns zero (no error) if all elements of the array are in the COMP_WORDS array,
# otherwise returns 1 (error).
function CompWordsContainsArray() {
  declare -a localArray
  localArray=("$@")
  local findme
  for findme in "${localArray[@]}"; do
    if ElementNotInCompWords "$findme"; then return 1; fi
  done
  return 0
}
function ElementNotInCompWords() {
  local findme="$1"
  local element
  for element in "${COMP_WORDS[@]}"; do
    if [[ "$findme" = "$element" ]]; then return 1; fi
  done
  return 0
}

# The `currentPositionalIndex` function calculates the index of the current positional parameter.
#
# currentPositionalIndex takes three parameters:
# the command name,
# a space-separated string with the names of options that take a parameter, and
# a space-separated string with the names of boolean options (that don't take any params).
# When done, this function echos the current positional index to std_out.
#
# Example usage:
# local currIndex=$(currentPositionalIndex "mysubcommand" "$ARG_OPTS" "$FLAG_OPTS")
function currentPositionalIndex() {
  local commandName="$1"
  local optionsWithArgs="$2"
  local booleanOptions="$3"
  local previousWord
  local result=0

  for i in $(seq $((COMP_CWORD - 1)) -1 0); do
    previousWord=${COMP_WORDS[i]}
    if [ "${previousWord}" = "$commandName" ]; then
      break
    fi
    if [[ "${optionsWithArgs}" =~ ${previousWord} ]]; then
      ((result-=2)) # Arg option and its value not counted as positional param
    elif [[ "${booleanOptions}" =~ ${previousWord} ]]; then
      ((result-=1)) # Flag option itself not counted as positional param
    fi
    ((result++))
  done
  echo "$result"
}

# compReplyArray generates a list of completion suggestions based on an array, ensuring all values are properly escaped.
#
# compReplyArray takes a single parameter: the array of options to be displayed
#
# The output is echoed to std_out, one option per line.
#
# Example usage:
# local options=("foo", "bar", "baz")
# local IFS=$'\n'
# COMPREPLY=($(compReplyArray "${options[@]}"))
function compReplyArray() {
  declare -a options
  options=("$@")
  local curr_word=${COMP_WORDS[COMP_CWORD]}
  local i
  local quoted
  local optionList=()

  for (( i=0; i<${#options[@]}; i++ )); do
    # Double escape, since we want escaped values, but compgen -W expands the argument
    printf -v quoted %q "${options[i]}"
    quoted=\'${quoted//\'/\'\\\'\'}\'

    optionList[i]=$quoted
  done

  # We also have to add another round of escaping to $curr_word.
  curr_word=${curr_word//\\/\\\\}
  curr_word=${curr_word//\'/\\\'}

  # Actually generate completions.
  local IFS=$'\n'
  echo -e "$(compgen -W "${optionList[*]}" -- "$curr_word")"
}

# =============================================================================
# MDT API-based dynamic completion helpers
# =============================================================================

# Get the N-th positional argument value (0-based index) for a subcommand.
# cmd: subcommand name (e.g. "instance" for "start instance")
# optionsWithArgs: space-separated option names that take an argument
# booleanOptions: space-separated boolean option names
function _mdt_get_positional_at() {
  local cmd="$1"
  local optionsWithArgs="$2"
  local booleanOptions="$3"
  local targetIdx="$4"
  local result=()
  local foundCmd=0
  local skipNext=0

  for i in $(seq 1 $((COMP_CWORD - 1))); do
    local w="${COMP_WORDS[i]}"
    if [ "$foundCmd" -eq 0 ]; then
      [ "$w" = "$cmd" ] && foundCmd=1
      continue
    fi
    if [ "$skipNext" -eq 1 ]; then
      skipNext=0
      continue
    fi
    if [[ " ${optionsWithArgs} " == *" ${w} "* ]]; then
      skipNext=1
      continue
    fi
    if [[ " ${booleanOptions} " == *" ${w} "* ]]; then
      continue
    fi
    result+=("$w")
  done
  if [ "$targetIdx" -lt "${#result[@]}" ]; then
    echo "${result[$targetIdx]}"
  fi
}

# URL-encode a string for use in query parameters
function _mdt_urlencode() {
  local string="$1"
  local strlen=${#string}
  local encoded=""
  local c o
  for (( pos=0; pos<strlen; pos++ )); do
    c=${string:$pos:1}
    case "$c" in
      [-_.~a-zA-Z0-9]) o="${c}" ;;
      *) printf -v o '%%%02x' "'$c" ;;
    esac
    encoded+="${o}"
  done
  echo "${encoded}"
}

# Fetch candidates from MDT API. Returns lines (one per candidate) or empty on error.
function _mdt_fetch_ids() {
  local type="$1"  # non-running, running, or all
  [ -z "${MDT_URL}" ] && return 1
  curl -sfS "${MDT_URL}/list/ids/${type}" 2>/dev/null || true
}

function _mdt_fetch_parameters() {
  local instance="$1"
  [ -z "${MDT_URL}" ] || [ -z "$instance" ] && return 1
  local enc=$(_mdt_urlencode "$instance")
  curl -sfS "${MDT_URL}/list/parameters?instance=${enc}" 2>/dev/null || true
}

function _mdt_fetch_operations() {
  local instance="$1"
  [ -z "${MDT_URL}" ] || [ -z "$instance" ] && return 1
  local enc=$(_mdt_urlencode "$instance")
  curl -sfS "${MDT_URL}/list/operations?instance=${enc}" 2>/dev/null || true
}

function _mdt_fetch_arguments() {
  local instance="$1"
  local operation="$2"
  [ -z "${MDT_URL}" ] || [ -z "$instance" ] || [ -z "$operation" ] && return 1
  local enc_inst=$(_mdt_urlencode "$instance")
  local enc_op=$(_mdt_urlencode "$operation")
  curl -sfS "${MDT_URL}/list/arguments?instance=${enc_inst}&operation=${enc_op}" 2>/dev/null || true
}

function _mdt_fetch_submodels() {
  local instance="$1"
  [ -z "${MDT_URL}" ] || [ -z "$instance" ] && return 1
  local enc=$(_mdt_urlencode "$instance")
  curl -sfS "${MDT_URL}/list/submodels?instance=${enc}" 2>/dev/null || true
}

function _mdt_fetch_timeseries() {
  local instance="$1"
  [ -z "${MDT_URL}" ] || [ -z "$instance" ] && return 1
  local enc=$(_mdt_urlencode "$instance")
  curl -sfS "${MDT_URL}/list/timeseries?instance=${enc}" 2>/dev/null || true
}

function _mdt_fetch_elements() {
  local instance="$1"
  local submodel="$2"
  local path="$3"
  [ -z "${MDT_URL}" ] || [ -z "$instance" ] || [ -z "$submodel" ] && return 1
  local enc_inst=$(_mdt_urlencode "$instance")
  local enc_sm=$(_mdt_urlencode "$submodel")
  local enc_path=$(_mdt_urlencode "$path")
  curl -sfS "${MDT_URL}/list/elements?instance=${enc_inst}&submodel=${enc_sm}&path=${enc_path}" 2>/dev/null || true
}

# Workflow API (MDT_WORKFLOW_ENDPOINT)
function _mdt_fetch_wf_models() {
  [ -z "${MDT_WORKFLOW_ENDPOINT}" ] && return 1
  curl -sfS "${MDT_WORKFLOW_ENDPOINT}/list/models" 2>/dev/null || true
}

function _mdt_fetch_wf_workflows() {
  local status="$1"  # all, stopped, running
  [ -z "${MDT_WORKFLOW_ENDPOINT}" ] && return 1
  curl -sfS "${MDT_WORKFLOW_ENDPOINT}/list/workflows?status=${status}" 2>/dev/null || true
}

# Bash completion entry point function.
# _complete_mdt_picocli finds which commands and subcommands have been specified
# on the command line and delegates to the appropriate function
# to generate possible options and subcommands for the last specified subcommand.
function _complete_mdt_picocli() {
  # Edge case: if command line has no space after subcommand, then don't assume this subcommand is selected (remkop/picocli#1468).
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} endpoints" ];    then _picocli_mdt_picocli; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} build" ];    then _picocli_mdt_picocli; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} list" ];    then _picocli_mdt_picocli; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} remove" ];    then _picocli_mdt_picocli; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} start" ];    then _picocli_mdt_picocli; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} stop" ];    then _picocli_mdt_picocli; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} add" ];    then _picocli_mdt_picocli; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get" ];    then _picocli_mdt_picocli; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} set" ];    then _picocli_mdt_picocli; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} run" ];    then _picocli_mdt_picocli; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} resolve" ];    then _picocli_mdt_picocli; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} simulation" ];    then _picocli_mdt_picocli; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} list instances" ];    then _picocli_mdt_picocli_list; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} list shells" ];    then _picocli_mdt_picocli_list; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} list submodels" ];    then _picocli_mdt_picocli_list; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} list operations" ];    then _picocli_mdt_picocli_list; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} list wfmodels" ];    then _picocli_mdt_picocli_list; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} list workflows" ];    then _picocli_mdt_picocli_list; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} remove instance" ];    then _picocli_mdt_picocli_remove; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} remove file" ];    then _picocli_mdt_picocli_remove; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} remove wfmodel" ];    then _picocli_mdt_picocli_remove; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} remove workflow" ];    then _picocli_mdt_picocli_remove; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} start instance" ];    then _picocli_mdt_picocli_start; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} start workflow" ];    then _picocli_mdt_picocli_start; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} stop instance" ];    then _picocli_mdt_picocli_stop; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} stop workflow" ];    then _picocli_mdt_picocli_stop; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} add instance" ];    then _picocli_mdt_picocli_add; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} add wfmodel" ];    then _picocli_mdt_picocli_add; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get instance" ];    then _picocli_mdt_picocli_get; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get mdt-info" ];    then _picocli_mdt_picocli_get; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get element" ];    then _picocli_mdt_picocli_get; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get parameter" ];    then _picocli_mdt_picocli_get; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get argument" ];    then _picocli_mdt_picocli_get; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get shell" ];    then _picocli_mdt_picocli_get; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get submodel" ];    then _picocli_mdt_picocli_get; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get file" ];    then _picocli_mdt_picocli_get; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get timeseries" ];    then _picocli_mdt_picocli_get; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get ts" ];    then _picocli_mdt_picocli_get; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get wfmodel" ];    then _picocli_mdt_picocli_get; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get workflow" ];    then _picocli_mdt_picocli_get; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get instance submodels" ];    then _picocli_mdt_picocli_get_instance; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get instance parameters" ];    then _picocli_mdt_picocli_get_instance; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get instance operations" ];    then _picocli_mdt_picocli_get_instance; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get instance compositions" ];    then _picocli_mdt_picocli_get_instance; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get instance log" ];    then _picocli_mdt_picocli_get_instance; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get wfmodel script" ];    then _picocli_mdt_picocli_get_wfmodel; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} get workflow log" ];    then _picocli_mdt_picocli_get_workflow; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} set element" ];    then _picocli_mdt_picocli_set; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} set parameter" ];    then _picocli_mdt_picocli_set; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} set argument" ];    then _picocli_mdt_picocli_set; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} set file" ];    then _picocli_mdt_picocli_set; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} run operation" ];    then _picocli_mdt_picocli_run; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} run submodel" ];    then _picocli_mdt_picocli_run; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} run restful" ];    then _picocli_mdt_picocli_run; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} run set" ];    then _picocli_mdt_picocli_run; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} resolve reference" ];    then _picocli_mdt_picocli_resolve; return $?; fi
  if [ "${COMP_LINE}" = "${COMP_WORDS[0]} simulation run" ];    then _picocli_mdt_picocli_simulation; return $?; fi

  # Find the longest sequence of subcommands and call the bash function for that subcommand.
  local cmds0=(endpoints)
  local cmds1=(build)
  local cmds2=(list)
  local cmds3=(remove)
  local cmds4=(start)
  local cmds5=(stop)
  local cmds6=(add)
  local cmds7=(get)
  local cmds8=(set)
  local cmds9=(run)
  local cmds10=(resolve)
  local cmds11=(simulation)
  local cmds12=(list instances)
  local cmds13=(list shells)
  local cmds14=(list submodels)
  local cmds15=(list operations)
  local cmds16=(list wfmodels)
  local cmds17=(list workflows)
  local cmds18=(remove instance)
  local cmds19=(remove file)
  local cmds20=(remove wfmodel)
  local cmds21=(remove workflow)
  local cmds22=(start instance)
  local cmds23=(start workflow)
  local cmds24=(stop instance)
  local cmds25=(stop workflow)
  local cmds26=(add instance)
  local cmds27=(add wfmodel)
  local cmds28=(get instance)
  local cmds29=(get mdt-info)
  local cmds30=(get element)
  local cmds31=(get parameter)
  local cmds32=(get argument)
  local cmds33=(get shell)
  local cmds34=(get submodel)
  local cmds35=(get file)
  local cmds36=(get timeseries)
  local cmds37=(get ts)
  local cmds38=(get wfmodel)
  local cmds39=(get workflow)
  local cmds40=(get instance submodels)
  local cmds41=(get instance parameters)
  local cmds42=(get instance operations)
  local cmds43=(get instance compositions)
  local cmds44=(get instance log)
  local cmds45=(get wfmodel script)
  local cmds46=(get workflow log)
  local cmds47=(set element)
  local cmds48=(set parameter)
  local cmds49=(set argument)
  local cmds50=(set file)
  local cmds51=(run operation)
  local cmds52=(run submodel)
  local cmds53=(run restful)
  local cmds54=(run set)
  local cmds55=(resolve reference)
  local cmds56=(simulation run)

  if CompWordsContainsArray "${cmds56[@]}"; then _picocli_mdt_picocli_simulation_run; return $?; fi
  if CompWordsContainsArray "${cmds55[@]}"; then _picocli_mdt_picocli_resolve_reference; return $?; fi
  if CompWordsContainsArray "${cmds54[@]}"; then _picocli_mdt_picocli_run_set; return $?; fi
  if CompWordsContainsArray "${cmds53[@]}"; then _picocli_mdt_picocli_run_restful; return $?; fi
  if CompWordsContainsArray "${cmds52[@]}"; then _picocli_mdt_picocli_run_submodel; return $?; fi
  if CompWordsContainsArray "${cmds51[@]}"; then _picocli_mdt_picocli_run_operation; return $?; fi
  if CompWordsContainsArray "${cmds50[@]}"; then _picocli_mdt_picocli_set_file; return $?; fi
  if CompWordsContainsArray "${cmds49[@]}"; then _picocli_mdt_picocli_set_argument; return $?; fi
  if CompWordsContainsArray "${cmds48[@]}"; then _picocli_mdt_picocli_set_parameter; return $?; fi
  if CompWordsContainsArray "${cmds47[@]}"; then _picocli_mdt_picocli_set_element; return $?; fi
  if CompWordsContainsArray "${cmds46[@]}"; then _picocli_mdt_picocli_get_workflow_log; return $?; fi
  if CompWordsContainsArray "${cmds45[@]}"; then _picocli_mdt_picocli_get_wfmodel_script; return $?; fi
  if CompWordsContainsArray "${cmds44[@]}"; then _picocli_mdt_picocli_get_instance_log; return $?; fi
  if CompWordsContainsArray "${cmds43[@]}"; then _picocli_mdt_picocli_get_instance_compositions; return $?; fi
  if CompWordsContainsArray "${cmds42[@]}"; then _picocli_mdt_picocli_get_instance_operations; return $?; fi
  if CompWordsContainsArray "${cmds41[@]}"; then _picocli_mdt_picocli_get_instance_parameters; return $?; fi
  if CompWordsContainsArray "${cmds40[@]}"; then _picocli_mdt_picocli_get_instance_submodels; return $?; fi
  if CompWordsContainsArray "${cmds39[@]}"; then _picocli_mdt_picocli_get_workflow; return $?; fi
  if CompWordsContainsArray "${cmds38[@]}"; then _picocli_mdt_picocli_get_wfmodel; return $?; fi
  if CompWordsContainsArray "${cmds37[@]}"; then _picocli_mdt_picocli_get_ts; return $?; fi
  if CompWordsContainsArray "${cmds36[@]}"; then _picocli_mdt_picocli_get_timeseries; return $?; fi
  if CompWordsContainsArray "${cmds35[@]}"; then _picocli_mdt_picocli_get_file; return $?; fi
  if CompWordsContainsArray "${cmds34[@]}"; then _picocli_mdt_picocli_get_submodel; return $?; fi
  if CompWordsContainsArray "${cmds33[@]}"; then _picocli_mdt_picocli_get_shell; return $?; fi
  if CompWordsContainsArray "${cmds32[@]}"; then _picocli_mdt_picocli_get_argument; return $?; fi
  if CompWordsContainsArray "${cmds31[@]}"; then _picocli_mdt_picocli_get_parameter; return $?; fi
  if CompWordsContainsArray "${cmds30[@]}"; then _picocli_mdt_picocli_get_element; return $?; fi
  if CompWordsContainsArray "${cmds29[@]}"; then _picocli_mdt_picocli_get_mdtinfo; return $?; fi
  if CompWordsContainsArray "${cmds28[@]}"; then _picocli_mdt_picocli_get_instance; return $?; fi
  if CompWordsContainsArray "${cmds27[@]}"; then _picocli_mdt_picocli_add_wfmodel; return $?; fi
  if CompWordsContainsArray "${cmds26[@]}"; then _picocli_mdt_picocli_add_instance; return $?; fi
  if CompWordsContainsArray "${cmds25[@]}"; then _picocli_mdt_picocli_stop_workflow; return $?; fi
  if CompWordsContainsArray "${cmds24[@]}"; then _picocli_mdt_picocli_stop_instance; return $?; fi
  if CompWordsContainsArray "${cmds23[@]}"; then _picocli_mdt_picocli_start_workflow; return $?; fi
  if CompWordsContainsArray "${cmds22[@]}"; then _picocli_mdt_picocli_start_instance; return $?; fi
  if CompWordsContainsArray "${cmds21[@]}"; then _picocli_mdt_picocli_remove_workflow; return $?; fi
  if CompWordsContainsArray "${cmds20[@]}"; then _picocli_mdt_picocli_remove_wfmodel; return $?; fi
  if CompWordsContainsArray "${cmds19[@]}"; then _picocli_mdt_picocli_remove_file; return $?; fi
  if CompWordsContainsArray "${cmds18[@]}"; then _picocli_mdt_picocli_remove_instance; return $?; fi
  if CompWordsContainsArray "${cmds17[@]}"; then _picocli_mdt_picocli_list_workflows; return $?; fi
  if CompWordsContainsArray "${cmds16[@]}"; then _picocli_mdt_picocli_list_wfmodels; return $?; fi
  if CompWordsContainsArray "${cmds15[@]}"; then _picocli_mdt_picocli_list_operations; return $?; fi
  if CompWordsContainsArray "${cmds14[@]}"; then _picocli_mdt_picocli_list_submodels; return $?; fi
  if CompWordsContainsArray "${cmds13[@]}"; then _picocli_mdt_picocli_list_shells; return $?; fi
  if CompWordsContainsArray "${cmds12[@]}"; then _picocli_mdt_picocli_list_instances; return $?; fi
  if CompWordsContainsArray "${cmds11[@]}"; then _picocli_mdt_picocli_simulation; return $?; fi
  if CompWordsContainsArray "${cmds10[@]}"; then _picocli_mdt_picocli_resolve; return $?; fi
  if CompWordsContainsArray "${cmds9[@]}"; then _picocli_mdt_picocli_run; return $?; fi
  if CompWordsContainsArray "${cmds8[@]}"; then _picocli_mdt_picocli_set; return $?; fi
  if CompWordsContainsArray "${cmds7[@]}"; then _picocli_mdt_picocli_get; return $?; fi
  if CompWordsContainsArray "${cmds6[@]}"; then _picocli_mdt_picocli_add; return $?; fi
  if CompWordsContainsArray "${cmds5[@]}"; then _picocli_mdt_picocli_stop; return $?; fi
  if CompWordsContainsArray "${cmds4[@]}"; then _picocli_mdt_picocli_start; return $?; fi
  if CompWordsContainsArray "${cmds3[@]}"; then _picocli_mdt_picocli_remove; return $?; fi
  if CompWordsContainsArray "${cmds2[@]}"; then _picocli_mdt_picocli_list; return $?; fi
  if CompWordsContainsArray "${cmds1[@]}"; then _picocli_mdt_picocli_build; return $?; fi
  if CompWordsContainsArray "${cmds0[@]}"; then _picocli_mdt_picocli_endpoints; return $?; fi

  # No subcommands were specified; generate completions for the top-level command.
  _picocli_mdt_picocli; return $?;
}

# Generates completions for the options and subcommands of the `mdt_picocli` command.
function _picocli_mdt_picocli() {
  # Get completion data
  local curr_word=${COMP_WORDS[COMP_CWORD]}

  local commands="endpoints build list remove start stop add get set run resolve simulation"
  local flag_opts="-h --help -V --version"
  local arg_opts=""

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    local IFS=$'\n'
    COMPREPLY=( $(compgen -W "${commands// /$'\n'}${IFS}${positionals}" -- "${curr_word}") )
  fi
}

# Generates completions for the options and subcommands of the `endpoints` subcommand.
function _picocli_mdt_picocli_endpoints() {
  # Get completion data
  local curr_word=${COMP_WORDS[COMP_CWORD]}
  local prev_word=${COMP_WORDS[COMP_CWORD-1]}

  local commands=""
  local flag_opts="-h --help -V --version"
  local arg_opts="--client_conf --loglevel"

  type compopt &>/dev/null && compopt +o default

  case ${prev_word} in
    --client_conf)
      local IFS=$'\n'
      type compopt &>/dev/null && compopt -o filenames
      COMPREPLY=( $( compgen -f -- "${curr_word}" ) ) # files
      return $?
      ;;
    --loglevel)
      return
      ;;
  esac

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    local IFS=$'\n'
    COMPREPLY=( $(compgen -W "${commands// /$'\n'}${IFS}${positionals}" -- "${curr_word}") )
  fi
}

# Generates completions for the options and subcommands of the `build` subcommand.
function _picocli_mdt_picocli_build() {
  # Get completion data
  local curr_word=${COMP_WORDS[COMP_CWORD]}
  local prev_word=${COMP_WORDS[COMP_CWORD-1]}

  local commands=""
  local flag_opts="-h --help -V --version"
  local arg_opts="--client_conf --loglevel"

  type compopt &>/dev/null && compopt +o default

  case ${prev_word} in
    --client_conf)
      local IFS=$'\n'
      type compopt &>/dev/null && compopt -o filenames
      COMPREPLY=( $( compgen -f -- "${curr_word}" ) ) # files
      return $?
      ;;
    --loglevel)
      return
      ;;
  esac

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    local currIndex
    currIndex=$(currentPositionalIndex "build" "${arg_opts}" "${flag_opts}")
    if (( currIndex >= 1 && currIndex <= 1 )); then
      local IFS=$'\n'
      type compopt &>/dev/null && compopt -o filenames
      positionals=$( compgen -f -- "${curr_word}" ) # files
    fi
    local IFS=$'\n'
    COMPREPLY=( $(compgen -W "${commands// /$'\n'}${IFS}${positionals}" -- "${curr_word}") )
  fi
}

