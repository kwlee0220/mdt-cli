  esac

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    local currIdx inst
    currIdx=$(currentPositionalIndex "ts" "${arg_opts}" "${flag_opts}")
    if (( currIdx == 0 )); then
      positionals=$(_mdt_fetch_ids "running" 2>/dev/null)
    elif (( currIdx >= 1 )); then
      inst=$(_mdt_get_positional_at "ts" "${arg_opts}" "${flag_opts}" 0)
      positionals=$(_mdt_fetch_timeseries "$inst" 2>/dev/null)
    fi
    local IFS=$'\n'
    COMPREPLY=( $(compgen -W "${commands// /$'\n'}${IFS}${positionals}" -- "${curr_word}") )
  fi
}

# Generates completions for the options and subcommands of the `wfmodel` subcommand.
function _picocli_mdt_picocli_get_wfmodel() {
  # Get completion data
  local curr_word=${COMP_WORDS[COMP_CWORD]}
  local prev_word=${COMP_WORDS[COMP_CWORD-1]}

  local commands="script"
  local flag_opts="-h --help -V --version"
  local arg_opts="--client_conf --loglevel --output -o"

  type compopt &>/dev/null && compopt +o default

  case ${prev_word} in
    --client_conf)
      local IFS=$'\n'
      type compopt &>/dev/null && compopt -o filenames
      COMPREPLY=( $( compgen -f -- "${curr_word}" ) ) # files
      return $?
      ;;
    --loglevel)
      return
      ;;
    --output|-o)
      return
      ;;
  esac

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    local currIdx
    currIdx=$(currentPositionalIndex "wfmodel" "${arg_opts}" "${flag_opts}")
    if (( currIdx == 0 )); then
      # `mdt get wfmodel <TAB>`: suggest workflow model IDs only
      positionals=$(_mdt_fetch_wf_models 2>/dev/null)
      local IFS=$'\n'
      COMPREPLY=( $(compgen -W "${positionals}" -- "${curr_word}") )
    else
      # after a wf-model has been entered, suggest subcommands (e.g. `script`)
      local IFS=$'\n'
      COMPREPLY=( $(compgen -W "${commands// /$'\n'}" -- "${curr_word}") )
    fi
  fi
}

