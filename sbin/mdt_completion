# Generates completions for the options and subcommands of the `instances` subcommand.
function _picocli_mdt_picocli_list_instances() {
  # Get completion data
  local curr_word=${COMP_WORDS[COMP_CWORD]}
  local prev_word=${COMP_WORDS[COMP_CWORD-1]}

  local commands=""
  local flag_opts="--table -t --long -l --pretty --show-endpoint -v -h --help -V --version"
  local arg_opts="--client_conf --loglevel --filter -f --output -o --repeat -r --delimiter -d"
  local type_option_args=("CSV" "TABLE" "TREE" "JSON") # --output values

  type compopt &>/dev/null && compopt +o default

  case ${prev_word} in
    --client_conf)
      local IFS=$'\n'
      type compopt &>/dev/null && compopt -o filenames
      COMPREPLY=( $( compgen -f -- "${curr_word}" ) ) # files
      return $?
      ;;
    --loglevel)
      return
      ;;
    --filter|-f)
      return
      ;;
    --output|-o)
      local IFS=$'\n'
      COMPREPLY=( $( compReplyArray "${type_option_args[@]}" ) )
      return $?
      ;;
    --repeat|-r)
      return
      ;;
    --delimiter|-d)
      return
      ;;
  esac

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    local IFS=$'\n'
    COMPREPLY=( $(compgen -W "${commands// /$'\n'}${IFS}${positionals}" -- "${curr_word}") )
  fi
}

