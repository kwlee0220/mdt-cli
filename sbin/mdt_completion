# Generates completions for the options and subcommands of the `element` subcommand.
function _picocli_mdt_picocli_set_element() {
  # Get completion data
  local curr_word=${COMP_WORDS[COMP_CWORD]}
  local prev_word=${COMP_WORDS[COMP_CWORD-1]}

  local commands=""
  local flag_opts="-h --help -V --version"
  local arg_opts="--client_conf --loglevel --jsonFile --json --file --path --mimeType"

  type compopt &>/dev/null && compopt +o default

  case ${prev_word} in
    --client_conf)
      local IFS=$'\n'
      type compopt &>/dev/null && compopt -o filenames
      COMPREPLY=( $( compgen -f -- "${curr_word}" ) ) # files
      return $?
      ;;
    --loglevel)
      return
      ;;
    --jsonFile)
      return
      ;;
    --json)
      return
      ;;
    --file)
      local IFS=$'\n'
      type compopt &>/dev/null && compopt -o filenames
      COMPREPLY=( $( compgen -f -- "${curr_word}" ) ) # files
      return $?
      ;;
    --path)
      return
      ;;
    --mimeType)
      return
      ;;
  esac

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    local currIdx inst sm
    currIdx=$(currentPositionalIndex "element" "${arg_opts}" "${flag_opts}")
    if (( currIdx == 0 )); then
      positionals=$(_mdt_fetch_ids "running" 2>/dev/null)
    elif (( currIdx == 1 )); then
      inst=$(_mdt_get_positional_at "element" "${arg_opts}" "${flag_opts}" 0)
      positionals=$(_mdt_fetch_submodels "$inst" 2>/dev/null)
    elif (( currIdx >= 2 )); then
      inst=$(_mdt_get_positional_at "element" "${arg_opts}" "${flag_opts}" 0)
      sm=$(_mdt_get_positional_at "element" "${arg_opts}" "${flag_opts}" 1)
      positionals=$(_mdt_fetch_elements "$inst" "$sm" "${curr_word}" 2>/dev/null)
    fi
    local IFS=$'\n'
    COMPREPLY=( $(compgen -W "${commands// /$'\n'}${IFS}${positionals}" -- "${curr_word}") )
  fi
}

