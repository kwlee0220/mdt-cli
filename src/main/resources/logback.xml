<configuration>
	<!--
		mdt-cli 기본 로그 설정.
		$MDT_CLIENT_HOME(없으면 현재 디렉토리)에 logback.xml이 있으면 그 파일을 쓰고, 없을 때 이 설정을 쓴다.
		로그는 표준 에러로 보내 표준 출력의 명령 결과(CSV, JSON 등)와 섞이지 않게 한다.
	-->
	<appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
		<target>System.err</target>
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
		</encoder>
	</appender>

	<root level="info">
		<appender-ref ref="STDERR" />
	</root>
</configuration>
